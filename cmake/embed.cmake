# Generates EmbeddedData.cpp: the boot ROM and the default boot disk compiled into the binary.
# cmake -DROM=... -DDISK=... -DDISK_NAME=... -DWORDMARK=... -DOUT=... -P cmake/embed.cmake
function(to_array file var out)
  file(READ ${file} hex HEX)
  string(LENGTH "${hex}" n)
  math(EXPR bytes "${n} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," arr "${hex}")
  string(REGEX REPLACE "((0x..,){32})" "\\1\n" arr "${arr}")
  set(${out} "const uint8_t ${var}[] = {\n${arr}\n};\nconst size_t ${var}Size = ${bytes};\n" PARENT_SCOPE)
endfunction()
to_array(${ROM} kRom rom)
to_array(${DISK} kBootDisk disk)
to_array(${WORDMARK} kWordmarkPng wordmark)
file(WRITE ${OUT} "// Generated by cmake/embed.cmake\n#include \"EmbeddedData.h\"\nnamespace embedded {\n${rom}${disk}${wordmark}const char* const kBootDiskName = \"${DISK_NAME}\";\n}\n")
